--- a/src/http/v2/ngx_http_v2.c
+++ b/src/http/v2/ngx_http_v2.c
@@ -47,6 +47,19 @@
 
 #define NGX_HTTP_V2_FRAME_BUFFER_SIZE            24
 
+
+/*
+ * nginx2root lab instrumentation (N2R).
+ *
+ * The [n2r] log lines are read-only observers.  The accelerator is the
+ * only behaviour change and it is compiled into this lab image on
+ * purpose: it is reachable only after the flow-control invariant has
+ * already been broken, and it jumps the (already invalid) counter to
+ * the state a real attack reaches after ~52 GiB of WINDOW_UPDATE
+ * traffic.  See README.md, section "O acelerador".
+ */
+
+#define N2R_ACCEL_MAGIC      0x4E325221u   /* "N2R!" */
 
 static void ngx_http_v2_read_handler(ngx_event_t *rev);
 static void ngx_http_v2_write_handler(ngx_event_t *wev);
@@ -2574,6 +2587,26 @@
 
     h2c->send_window += window;
 
+    if (h2c->send_window > (size_t) NGX_HTTP_V2_MAX_WINDOW) {
+        ngx_log_error(NGX_LOG_ALERT, h2c->connection->log, 0,
+            "[n2r] FLOW-CONTROL CHECK BYPASSED: increment=%uz accepted, "
+            "connection send_window=%uz (MAX+%uz), next legal increment "
+            "would be up to %uz",
+            window, h2c->send_window,
+            h2c->send_window - (size_t) NGX_HTTP_V2_MAX_WINDOW,
+            (size_t) NGX_HTTP_V2_MAX_WINDOW - h2c->send_window);
+
+        if (window == N2R_ACCEL_MAGIC) {
+            h2c->send_window = (size_t) (off_t) -0x40000000;
+
+            ngx_log_error(NGX_LOG_ALERT, h2c->connection->log, 0,
+                "[n2r] ACCELERATOR: lab-only shortcut, jumping to the "
+                "accumulated end state send_window=%uz (2^64-1GiB); "
+                "the next response write will use a negative length",
+                h2c->send_window);
+        }
+    }
+
     while (!ngx_queue_empty(&h2c->waiting)) {
         q = ngx_queue_head(&h2c->waiting);
 
